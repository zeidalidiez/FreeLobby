{
  "name": "freelobby",
  "version": "1.0.0",
  "description": "A minimalist, browser-based multiplayer social room for introverts",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
